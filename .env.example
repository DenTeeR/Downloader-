# ───────── ضروری ─────────
# توکن ربات از @BotFather
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# آیدی عددی ادمین‌ها (با کاما جدا کنید). آیدی خود را از @userinfobot بگیرید
ADMIN_IDS=123456789

# ───────── عضویت اجباری (اختیاری) ─────────
# کانال‌های عمومی:     @channel1,@channel2
# کانال خصوصی:         -1001234567890|https://t.me/+InviteLink
# ربات باید در این کانال‌ها ادمین باشد. خالی = غیرفعال
FORCE_JOIN_CHANNELS=

# ───────── ارسال فایل‌های بزرگ (اختیاری) ─────────
# بدون سرور محلی، تلگرام حداکثر ۵۰ مگابایت آپلود قبول می‌کند.
# با سرور محلی Bot API (در docker-compose) تا ۲۰۰۰ مگابایت:
# BOT_API_SERVER=http://telegram-bot-api:8081
BOT_API_SERVER=
# برای سرور محلی: api_id و api_hash را از https://my.telegram.org بگیرید
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# در صورت نیاز محدودیت حجم را دستی تعیین کنید (مگابایت)
MAX_FILE_SIZE_MB=

# ───────── تنظیمات دانلود ─────────
# تعداد دانلود هم‌زمان روی سرور
MAX_CONCURRENT_DOWNLOADS=3
# حداکثر تعداد آهنگ برای آلبوم/پلی‌لیست (اسپاتیفای، ساندکلود) و پین‌های بورد پینترست
MAX_PLAYLIST_ITEMS=10
# ارسال دوباره فوری لینک‌های تکراری با file_id ذخیره شده
CACHE_ENABLED=true

# ───────── شبکه ─────────
# پروکسی برای تلگرام و دانلودها (مثلا http://127.0.0.1:8080 یا socks5://127.0.0.1:1080)
PROXY=
# موتور جاوااسکریپت yt-dlp برای یوتیوب: deno (پیش‌فرض) یا node
JS_RUNTIME=deno
# سرویس PO Token برای یوتیوب (در docker-compose: http://pot-provider:4416)
YOUTUBE_POT_URL=

# ───────── مسیرها ─────────
DOWNLOAD_DIR=downloads
DATABASE_PATH=data/bot.db
COOKIES_DIR=cookies
